# Copy this file to .env.local and fill in your keys.

# NVIDIA NIM API key for AI features (resume/cover letter generation, assistant).
# Get one at https://build.nvidia.com — leave unset to run in offline stub mode.
NVIDIA_API_KEY=

# NVIDIA NIM model (must be available for your API key's account).
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b